#!/bin/bash
# bible-cc — one-key script for all plugin operations.
# Usage: ./bible-cc <command> [options]
# Try:   ./bible-cc help
set -euo pipefail
cd "$(dirname "$0")"

case "${1:-help}" in
  # ── Install ──────────────────────────────────────────
  install)
    shift
    MARKETPLACE_NAME="bible-cc-local"
    # Install target IS the marketplace directory — Claude Code scans
    # ~/.claude/plugins/marketplaces/ at session startup for hook discovery.
    # source: "./" in marketplace.json means plugin == marketplace directory.
    TARGET="$HOME/.claude/plugins/marketplaces/${MARKETPLACE_NAME}"
    WORKSPACE="$(cd "$(dirname "$0")" && pwd)"
    PLUGIN_FULL_NAME="bible-cc-plugin@${MARKETPLACE_NAME}"

    echo "==> Installing to $TARGET ..."

    # Reinstall? If target exists and --force not passed, warn.
    if [ -d "$TARGET" ] && [ "${1:-}" != "--force" ]; then
        echo "Target already exists: $TARGET"
        echo "  Re-run with --force to overwrite, or use 'reinstall'."
        exit 1
    fi

    # Copy workspace → target (exclude dev artifacts).
    # The workspace .claude-plugin/marketplace.json (source: "./") works as-is
    # because the plugin files live in the same directory.
    echo "==> Copying files..."
    mkdir -p "$TARGET"
    rsync -a --delete \
        --exclude='.venv' \
        --exclude='.git' \
        --exclude='__pycache__' \
        --exclude='.pytest_cache' \
        --exclude='.mcp.json' \
        --exclude='.DS_Store' \
        --exclude='*.pyc' \
        "$WORKSPACE/" "$TARGET/"

    # Install deps in target
    echo "==> Installing dependencies..."
    cd "$TARGET"
    uv sync

    # Register plugin via local marketplace (hooks only fire from cache-installed plugins)
    echo "==> Registering plugin..."
    if command -v claude &>/dev/null; then
        # 1. Clean up old @skills-dir registration if present
        claude plugin disable bible-cc-plugin@skills-dir 2>/dev/null || true

        # 2. Clean up old install location (pre-merge: target was ~/.claude/plugins/bible-cc-plugin)
        rm -rf "$HOME/.claude/plugins/bible-cc-plugin"

        # 3. Register marketplace in both registries
        python3 -c "
import json, os
mp_path = os.path.expanduser('~/.claude/plugins/known_marketplaces.json')
mp_data = json.load(open(mp_path)) if os.path.exists(mp_path) else {}
mp_data['${MARKETPLACE_NAME}'] = {
    'source': {'source': 'directory', 'path': '${TARGET}'},
    'installLocation': '${TARGET}',
    'lastUpdated': '$(date -u +%Y-%m-%dT%H:%M:%S.000Z)'
}
json.dump(mp_data, open(mp_path, 'w'), indent=4)

spath = os.path.expanduser('~/.claude/settings.json')
cfg = json.load(open(spath)) if os.path.exists(spath) else {}
cfg.setdefault('extraKnownMarketplaces', {})['${MARKETPLACE_NAME}'] = {
    'source': {'source': 'directory', 'path': '${TARGET}'}
}
json.dump(cfg, open(spath, 'w'), indent=4)
"

        # 4. Install plugin from marketplace → cache (where hooks are discovered)
        claude plugin install "$PLUGIN_FULL_NAME" 2>&1
        echo "  Registered via marketplace: $PLUGIN_FULL_NAME"
    else
        # Fallback: @skills-dir (hooks won't fire — daemon must be started manually)
        echo "  WARNING: 'claude' CLI not found — using @skills-dir fallback."
        echo "  Hooks will NOT fire. Start daemon manually with: ./bible-cc start"
        python3 -c "
import json, os
spath = os.path.expanduser('~/.claude/settings.json')
cfg = json.load(open(spath)) if os.path.exists(spath) else {}
cfg.setdefault('enabledPlugins', {})['bible-cc-plugin@skills-dir'] = True
json.dump(cfg, open(spath, 'w'), indent=4)
"
    fi

    # Run setup (generates .mcp.json in target)
    echo "==> Running setup..."
    uv run python -m bible_cc_plugin.scripts.setup --non-interactive "$@"

    echo "==> Install complete."
    echo "Plugin installed at: $TARGET"
    echo "Hooks (SessionStart auto-start): enabled"
    echo "Restart Claude Code for hooks to take effect."
    ;;
  setup)
    shift; uv run python -m bible_cc_plugin.scripts.setup "$@" ;;

  # ── Daemon ───────────────────────────────────────────
  start)   shift; uv run python -m bible_cc_plugin.scripts.daemon start "$@" ;;
  stop)    shift; uv run python -m bible_cc_plugin.scripts.daemon stop "$@" --force ;;
  restart) shift; uv run python -m bible_cc_plugin.scripts.daemon stop --force 2>/dev/null || true
           sleep 1; uv run python -m bible_cc_plugin.scripts.daemon start "$@" ;;
  status)  uv run python -m bible_cc_plugin.scripts.daemon status ;;
  logs)    _DAEMON_LOG="$HOME/.bible-cc/daemon.log"
           if [ -f "$_DAEMON_LOG" ]; then
             tail -n 50 "$_DAEMON_LOG"
           else
             echo "(no daemon log at $_DAEMON_LOG)"
           fi ;;

  # ── Verify ───────────────────────────────────────────
  verify)  ./scripts/verify-install.sh ;;

  # ── Uninstall ────────────────────────────────────────
  uninstall) shift; ./scripts/uninstall.sh "$@" ;;

  # ── Full cycle ───────────────────────────────────────
  reinstall)
    echo "==> Full reinstall..."
    ./scripts/uninstall.sh --force 2>/dev/null || true
    # Install target IS the marketplace directory (same as install case).
    MARKETPLACE_NAME="bible-cc-local"
    TARGET="$HOME/.claude/plugins/marketplaces/${MARKETPLACE_NAME}"
    WORKSPACE="$(cd "$(dirname "$0")" && pwd)"
    PLUGIN_FULL_NAME="bible-cc-plugin@${MARKETPLACE_NAME}"
    mkdir -p "$TARGET"
    rsync -a --delete \
        --exclude='.venv' --exclude='.git' --exclude='__pycache__' \
        --exclude='.pytest_cache' --exclude='.mcp.json' --exclude='.DS_Store' \
        --exclude='*.pyc' \
        "$WORKSPACE/" "$TARGET/"
    cd "$TARGET"
    uv sync
    if command -v claude &>/dev/null; then
        claude plugin disable bible-cc-plugin@skills-dir 2>/dev/null || true
        rm -rf "$HOME/.claude/plugins/bible-cc-plugin"
        python3 -c "
import json, os
mp_path = os.path.expanduser('~/.claude/plugins/known_marketplaces.json')
mp_data = json.load(open(mp_path)) if os.path.exists(mp_path) else {}
mp_data['${MARKETPLACE_NAME}'] = {
    'source': {'source': 'directory', 'path': '${TARGET}'},
    'installLocation': '${TARGET}',
    'lastUpdated': '$(date -u +%Y-%m-%dT%H:%M:%S.000Z)'
}
json.dump(mp_data, open(mp_path, 'w'), indent=4)

spath = os.path.expanduser('~/.claude/settings.json')
cfg = json.load(open(spath)) if os.path.exists(spath) else {}
cfg.setdefault('extraKnownMarketplaces', {})['${MARKETPLACE_NAME}'] = {
    'source': {'source': 'directory', 'path': '${TARGET}'}
}
json.dump(cfg, open(spath, 'w'), indent=4)
"
        claude plugin install "$PLUGIN_FULL_NAME" 2>&1
    else
        python3 -c "
import json, os
spath = os.path.expanduser('~/.claude/settings.json')
cfg = json.load(open(spath)) if os.path.exists(spath) else {}
cfg.setdefault('enabledPlugins', {})['bible-cc-plugin@skills-dir'] = True
json.dump(cfg, open(spath, 'w'), indent=4)
"
    fi
    uv run python -m bible_cc_plugin.scripts.setup --non-interactive
    uv run python -m bible_cc_plugin.scripts.daemon start
    ./scripts/verify-install.sh
    ;;
  reset)
    echo "==> Resetting config..."
    uv run python -m bible_cc_plugin.scripts.daemon stop --force 2>/dev/null || true
    uv run python -m bible_cc_plugin.scripts.setup --reset --non-interactive --force
    uv run python -m bible_cc_plugin.scripts.daemon start
    echo "==> Done. Run './bible-cc verify' to check."
    ;;

  # ── Dev / CI ─────────────────────────────────────────
  test)   shift; uv run pytest "$@" tests/ ;;
  lint)   shift; uv run ruff check "$@"; uv run ruff format --check "$@" ;;
  ci)     ./scripts/dev.sh ci ;;
  format) uv run ruff format; uv run ruff check --fix ;;

  # ── Help ─────────────────────────────────────────────
  help|--help|-h)
    echo "bible-cc — one-key script for bible-cc-plugin"
    echo ""
    echo "Usage: ./bible-cc <command> [options]"
    echo ""
    echo "Install & Config:"
    echo "  install             uv sync + setup --non-interactive"
    echo "  setup [--reset] [--non-interactive] [--base-url X] [--token X] [--debug]"
    echo "  uninstall [--force] stop daemon, remove config + data (--force skips confirmation)"
    echo "  reinstall           full cycle: uninstall → install → start → verify"
    echo "  reset               reset config + restart daemon"
    echo ""
    echo "Daemon:"
    echo "  start [--debug]     start daemon (idempotent)"
    echo "  stop                force-stop daemon"
    echo "  restart [--debug]   stop + start"
    echo "  status              show daemon status"
    echo "  logs                show last 50 lines of daemon log"
    echo ""
    echo "Verify & Test:"
    echo "  verify              run 16 install checks"
    echo "  test                run all tests"
    echo "  lint                ruff check + format check"
    echo "  ci                  lint → unit test → contract test"
    echo "  format              auto-format + fix"
    echo ""
    echo "Quick start:"
    echo "  ./bible-cc install   # first time"
    echo "  ./bible-cc start     # start daemon"
    echo "  ./bible-cc verify    # everything OK?"
    ;;
  *)
    echo "Unknown command: $1"
    echo "Run './bible-cc help' for usage."
    exit 1
    ;;
esac
